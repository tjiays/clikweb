# Copy to .env and fill in. Never commit .env itself.

# --- Database ---
# PostgreSQL connection string for the clik_web database.
DATABASE_URI=postgres://clik:REPLACE_WITH_PASSWORD@127.0.0.1:5432/clik_web

# --- Payload ---
# Long random string used to sign sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=REPLACE_WITH_RANDOM_SECRET

# Public URL the site is served from.
NEXT_PUBLIC_SERVER_URL=http://202.150.74.187:8080

# --- Email ---
# Staging captures mail with Mailpit instead of sending it.
# In production these are replaced with the corporate SMTP values.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM_NAME=CLIK Website
EMAIL_FROM_ADDRESS=no-reply@cbclik.com

# Where contact form submissions are emailed. Real recipient in production.
CONTACT_FORM_RECIPIENT=sales@cbclik.com
